---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = 'Medicina basada en evidencia para todos', image = '/og-default.svg' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Dr. Cristian Miranda</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | Dr. Cristian Miranda`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@cristianmirandamd" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,300;0,14..32,400;0,14..32,500;0,14..32,600;0,14..32,700;1,14..32,400&family=Lora:ital,wght@0,500;0,600;1,400;1,500&display=swap" rel="stylesheet" />
  </head>

  <body class="bg-white text-gray-900 antialiased">

    <!-- NAV -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-white/90 backdrop-blur-md border-b border-gray-100/80">
      <nav class="max-w-5xl mx-auto px-5 h-14 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 group">
          <div class="w-7 h-7 bg-gray-900 rounded-lg flex items-center justify-center shrink-0">
            <svg viewBox="0 0 28 28" class="w-full h-full">
              <text x="14" y="18" font-family="Georgia,serif" font-size="11" font-weight="700"
                    fill="#FF3A3A" text-anchor="middle">CM</text>
              <polyline points="3,22 7,22 8.5,19 10,25 11.5,16 13,22 16,22 17.5,20 19,22 25,22"
                        fill="none" stroke="#FF3A3A" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <span class="font-semibold text-sm text-gray-900 hidden sm:block">Dr. Cristian Miranda</span>
        </a>

        <div class="flex items-center gap-1">
          <a href="/blog"
             class={`px-3 py-1.5 rounded-lg text-sm transition-colors ${currentPath.startsWith('/blog') ? 'bg-gray-100 text-gray-900 font-medium' : 'text-gray-500 hover:text-gray-900 hover:bg-gray-50'}`}>
            Pacientes
          </a>
          <a href="/medicos"
             class={`px-3 py-1.5 rounded-lg text-sm transition-colors ${currentPath.startsWith('/medicos') ? 'bg-gray-100 text-gray-900 font-medium' : 'text-gray-500 hover:text-gray-900 hover:bg-gray-50'}`}>
            Médicos
          </a>
          <a href="/herramientas"
             class={`px-3 py-1.5 rounded-lg text-sm transition-colors hidden sm:block ${currentPath === '/herramientas' ? 'bg-gray-100 text-gray-900 font-medium' : 'text-gray-500 hover:text-gray-900 hover:bg-gray-50'}`}>
            Herramientas
          </a>
          <div class="w-px h-4 bg-gray-200 mx-1 hidden sm:block"></div>
          <a href="https://x.com/cristianmirandamd" target="_blank"
             class="p-1.5 rounded-lg text-gray-400 hover:text-gray-900 hover:bg-gray-50 transition-colors hidden sm:block">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.748l7.73-8.835L1.254 2.25H8.08l4.259 5.631z"/>
            </svg>
          </a>
          <a href="https://linkedin.com/in/cristian-miranda-med" target="_blank"
             class="p-1.5 rounded-lg text-gray-400 hover:text-blue-600 hover:bg-blue-50 transition-colors hidden sm:block">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
        </div>
      </nav>
    </header>

    <main class="pt-14">
      <slot />
    </main>

    <!-- FOOTER -->
    <footer class="mt-24 border-t border-gray-100">
      <div class="max-w-5xl mx-auto px-5 py-12">
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-8 mb-10">
          <div class="col-span-2 sm:col-span-1">
            <div class="flex items-center gap-2 mb-3">
              <div class="w-6 h-6 bg-gray-900 rounded-md flex items-center justify-center">
                <svg viewBox="0 0 24 24" class="w-full h-full">
                  <text x="12" y="16" font-family="Georgia,serif" font-size="9" font-weight="700"
                        fill="#FF3A3A" text-anchor="middle">CM</text>
                </svg>
              </div>
              <span class="font-semibold text-sm">Dr. Cristian Miranda</span>
            </div>
            <p class="text-xs text-gray-400 leading-relaxed">Medicina basada en evidencia. Médico colombiano en España, MIR 2026.</p>
          </div>
          <div>
            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3">Contenido</p>
            <ul class="space-y-2 text-sm text-gray-400">
              <li><a href="/blog" class="hover:text-gray-700 transition-colors">Para pacientes</a></li>
              <li><a href="/medicos" class="hover:text-gray-700 transition-colors">Para médicos</a></li>
              <li><a href="/herramientas" class="hover:text-gray-700 transition-colors">Herramientas</a></li>
            </ul>
          </div>
          <div>
            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3">Redes</p>
            <ul class="space-y-2 text-sm text-gray-400">
              <li><a href="https://linkedin.com/in/cristian-miranda-med" target="_blank" class="hover:text-gray-700 transition-colors">LinkedIn</a></li>
              <li><a href="https://x.com/cristianmirandamd" target="_blank" class="hover:text-gray-700 transition-colors">X / Twitter</a></li>
              <li><a href="https://instagram.com/cristianmirandamd" target="_blank" class="hover:text-gray-700 transition-colors">Instagram</a></li>
              <li><a href="https://tiktok.com/@cristianmirandamd" target="_blank" class="hover:text-gray-700 transition-colors">TikTok</a></li>
            </ul>
          </div>
          <div>
            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3">Legal</p>
            <p class="text-xs text-gray-400 leading-relaxed">Contenido educativo. No reemplaza consulta médica. Los enlaces de Amazon son de afiliados.</p>
          </div>
        </div>
        <div class="border-t border-gray-100 pt-6">
          <p class="text-xs text-gray-400 text-center">© {new Date().getFullYear()} Dr. Cristian Miranda · <span class="text-red-400">drcristianmiranda.com</span></p>
        </div>
      </div>
    </footer>
  </body>
</html>
