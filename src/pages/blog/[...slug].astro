---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date) {
  return date.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
}
---

<Layout title={post.data.title} description={post.data.description}>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 pt-12 pb-20">

    <!-- Breadcrumb -->
    <nav class="text-xs text-gray-400 mb-8 flex items-center gap-1.5">
      <a href="/" class="hover:text-gray-700 transition-colors">Inicio</a>
      <span>/</span>
      <a href="/blog" class="hover:text-gray-700 transition-colors">Para pacientes</a>
      <span>/</span>
      <span class="text-red-500">{post.data.category}</span>
    </nav>

    <!-- Header -->
    <header class="mb-10">
      <span class="text-xs text-red-500 font-medium uppercase tracking-wide">{post.data.category}</span>
      <h1 class="font-lora text-3xl sm:text-4xl font-semibold text-gray-900 mt-3 mb-4 leading-tight">{post.data.title}</h1>
      <p class="text-lg text-gray-500 leading-relaxed mb-5">{post.data.description}</p>
      <div class="flex items-center gap-3 text-sm text-gray-400">
        <span class="font-medium text-gray-700">{post.data.author}</span>
        <span>·</span>
        <time>{formatDate(post.data.pubDate)}</time>
      </div>
    </header>

    <div class="border-t border-gray-100 mb-10"></div>

    <!-- Contenido -->
    <div class="prose prose-gray prose-lg max-w-none
      prose-headings:font-lora prose-headings:font-semibold prose-headings:text-gray-900
      prose-p:text-gray-600 prose-p:leading-relaxed
      prose-a:text-red-500 prose-a:no-underline hover:prose-a:underline
      prose-strong:text-gray-900 prose-strong:font-semibold
      prose-blockquote:border-red-500 prose-blockquote:text-gray-500
      prose-code:text-red-600 prose-code:bg-red-50 prose-code:px-1 prose-code:rounded
      prose-ul:text-gray-600 prose-ol:text-gray-600">
      <Content />
    </div>

    <!-- Productos afiliados -->
    {post.data.affiliateProducts && post.data.affiliateProducts.length > 0 && (
      <div class="mt-14 border-t border-gray-100 pt-10">
        <h2 class="font-lora text-xl font-semibold text-gray-900 mb-2">Recomendaciones con evidencia</h2>
        <p class="text-sm text-gray-400 mb-6">Seleccionados según validación clínica. Los enlaces son de afiliados — no cambia nuestro criterio.</p>
        <div class="space-y-4">
          {post.data.affiliateProducts.map((product) => (
            <div class="border border-gray-100 rounded-2xl p-5 hover:border-amber-200 transition-colors">
              <div class="flex items-start justify-between gap-4">
                <div class="flex-1">
                  <h3 class="font-semibold text-gray-900 mb-1">{product.name}</h3>
                  <p class="text-sm text-gray-500 mb-2">{product.description}</p>
                  <span class="text-xs bg-green-50 text-green-700 px-2 py-0.5 rounded font-medium">{product.evidence}</span>
                </div>
                <div class="text-right shrink-0">
                  {product.price && <p class="text-sm font-semibold text-gray-900 mb-2">{product.price}</p>}
                  <a href={product.link} target="_blank" rel="noopener noreferrer nofollow"
                     class="inline-block bg-amber-500 text-white text-xs font-medium px-4 py-2 rounded-full hover:bg-amber-600 transition-colors">
                    Ver en Amazon
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Aviso médico -->
    <div class="mt-14 bg-gray-50 rounded-2xl p-5 text-sm text-gray-500">
      <strong class="text-gray-700">Aviso médico:</strong> Este artículo es contenido educativo basado en evidencia científica actualizada.
      No reemplaza la consulta con tu médico. Ante cualquier síntoma o duda, consulta a un profesional de salud.
    </div>

    <!-- Volver -->
    <div class="mt-10">
      <a href="/blog" class="text-sm text-gray-500 hover:text-gray-900 transition-colors">← Todos los artículos</a>
    </div>

  </article>
</Layout>
