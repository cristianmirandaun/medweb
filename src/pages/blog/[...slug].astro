---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date) {
  return date.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
}

const products = post.data.affiliateProducts ?? [];
const topProduct = products[0];
const restProducts = products.slice(1);
---

<Layout title={post.data.title} description={post.data.description}>
  <div class="max-w-5xl mx-auto px-5 pt-10 pb-20">
    <div class="lg:grid lg:grid-cols-[1fr_300px] lg:gap-14">

      <!-- COLUMNA PRINCIPAL -->
      <div>
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-1.5 text-xs text-gray-400 mb-8">
          <a href="/" class="hover:text-gray-700 transition-colors">Inicio</a>
          <span>/</span>
          <a href="/blog" class="hover:text-gray-700 transition-colors">Pacientes</a>
          <span>/</span>
          <span class="text-red-400">{post.data.category}</span>
        </nav>

        <!-- Header -->
        <header class="mb-8">
          <span class="inline-block text-xs font-semibold text-red-500 uppercase tracking-wider mb-3">{post.data.category}</span>
          <h1 class="font-lora text-3xl sm:text-[2.2rem] text-gray-900 leading-tight mb-4">{post.data.title}</h1>
          <p class="text-lg text-gray-500 leading-relaxed mb-5">{post.data.description}</p>
          <div class="flex items-center gap-3 text-sm text-gray-400 flex-wrap">
            <span class="font-medium text-gray-700">{post.data.author}</span>
            <span class="text-gray-200">·</span>
            <time>{formatDate(post.data.pubDate)}</time>
            {products.length > 0 && (
              <>
                <span class="text-gray-200">·</span>
                <a href="#recomendaciones" class="text-amber-600 font-medium hover:underline">
                  {products.length} recomendación{products.length !== 1 ? 'es' : ''} con evidencia ↓
                </a>
              </>
            )}
          </div>
        </header>

        <div class="border-t border-gray-100 mb-8"></div>

        <!-- PRODUCTO ESTRELLA — mobile: aquí; desktop: sidebar -->
        {topProduct && (
          <div class="lg:hidden mb-8">
            <a href={topProduct.link} target="_blank" rel="noopener noreferrer nofollow"
               class="block rounded-2xl border-2 border-amber-300 bg-gradient-to-br from-amber-50 to-orange-50 p-5 hover:border-amber-400 transition-all group">
              <div class="text-xs font-bold text-amber-700 uppercase tracking-wide mb-2">⭐ Mejor opción según evidencia</div>
              <div class="font-semibold text-gray-900 text-base mb-1 group-hover:text-amber-700 transition-colors">{topProduct.name}</div>
              <div class="text-sm text-gray-600 mb-3">{topProduct.description}</div>
              <div class="text-xs text-green-700 mb-3">✓ {topProduct.evidence}</div>
              <div class="flex items-center justify-between">
                {topProduct.price && <span class="font-bold text-gray-900">{topProduct.price}</span>}
                <span class="bg-amber-500 text-white text-sm font-semibold px-4 py-2 rounded-xl group-hover:bg-amber-600 transition-colors">
                  Ver en Amazon →
                </span>
              </div>
            </a>
          </div>
        )}

        <!-- Contenido editorial -->
        <div class="prose prose-gray max-w-none
          prose-headings:font-lora prose-headings:font-medium prose-headings:text-gray-900
          prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4
          prose-h3:text-lg prose-h3:mt-7 prose-h3:mb-3
          prose-p:text-gray-600 prose-p:leading-[1.8] prose-p:text-[1.05rem]
          prose-a:text-red-500 prose-a:font-medium prose-a:no-underline hover:prose-a:underline
          prose-strong:text-gray-900 prose-strong:font-semibold
          prose-blockquote:border-l-4 prose-blockquote:border-red-400 prose-blockquote:bg-red-50 prose-blockquote:px-5 prose-blockquote:py-3 prose-blockquote:rounded-r-xl prose-blockquote:not-italic prose-blockquote:text-gray-700
          prose-code:text-red-600 prose-code:bg-red-50 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-sm prose-code:font-normal
          prose-table:text-sm prose-th:bg-gray-50 prose-th:font-semibold prose-th:text-gray-700 prose-td:text-gray-600
          prose-ul:text-gray-600 prose-ol:text-gray-600 prose-li:leading-relaxed">
          <Content />
        </div>

        <!-- TODAS LAS RECOMENDACIONES -->
        {products.length > 0 && (
          <div id="recomendaciones" class="mt-14 scroll-mt-20">
            <div class="flex items-center gap-4 mb-6">
              <div class="h-px flex-1 bg-gray-100"></div>
              <h2 class="font-lora text-xl text-gray-900 shrink-0">Recomendaciones con evidencia</h2>
              <div class="h-px flex-1 bg-gray-100"></div>
            </div>
            <p class="text-xs text-center text-gray-400 mb-7">
              Seleccionados por respaldo científico, no por patrocinio. Los enlaces son de afiliados — no cambia mi criterio.
            </p>
            <div class="space-y-3">
              {products.map((product, i) => (
                <a href={product.link} target="_blank" rel="noopener noreferrer nofollow"
                   class={`flex items-start gap-4 rounded-2xl p-4 border transition-all group ${i === 0 ? 'border-amber-300 bg-amber-50 hover:bg-amber-100' : 'border-gray-100 hover:border-amber-200 hover:bg-gray-50'}`}>
                  <div class={`shrink-0 w-9 h-9 rounded-full flex items-center justify-center text-sm font-bold transition-colors ${i === 0 ? 'bg-amber-400 text-white' : 'bg-gray-100 text-gray-500 group-hover:bg-amber-100 group-hover:text-amber-700'}`}>
                    {i === 0 ? '★' : i + 1}
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="font-semibold text-gray-900 group-hover:text-amber-700 transition-colors">{product.name}</div>
                    <div class="text-sm text-gray-500 mt-0.5">{product.description}</div>
                    <div class="text-xs text-green-700 mt-1">✓ {product.evidence}</div>
                  </div>
                  <div class="shrink-0 text-right">
                    {product.price && <div class="font-bold text-gray-900 text-sm">{product.price}</div>}
                    <div class="text-xs text-amber-600 font-medium mt-1">Amazon →</div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Aviso -->
        <div class="mt-12 rounded-2xl bg-gray-50 border border-gray-100 px-5 py-4 text-sm text-gray-500">
          <strong class="text-gray-700">Aviso médico:</strong> Contenido educativo basado en evidencia científica. No reemplaza la consulta con tu médico.
        </div>

        <div class="mt-8">
          <a href="/blog" class="text-sm text-gray-400 hover:text-gray-700 transition-colors">← Todos los artículos</a>
        </div>
      </div>

      <!-- SIDEBAR desktop -->
      <aside class="hidden lg:block">
        <div class="sticky top-20 space-y-4">

          {topProduct && (
            <a href={topProduct.link} target="_blank" rel="noopener noreferrer nofollow"
               class="block rounded-2xl border-2 border-amber-300 bg-gradient-to-b from-amber-50 to-orange-50 p-5 hover:border-amber-400 transition-all group">
              <div class="text-xs font-bold text-amber-700 uppercase tracking-wide mb-3">⭐ Mejor opción</div>
              <div class="font-semibold text-gray-900 mb-1 group-hover:text-amber-700 transition-colors leading-snug">{topProduct.name}</div>
              <div class="text-sm text-gray-500 mb-3">{topProduct.description}</div>
              <div class="text-xs text-green-700 mb-4">✓ {topProduct.evidence}</div>
              {topProduct.price && <div class="font-bold text-gray-900 text-lg mb-3">{topProduct.price}</div>}
              <div class="w-full bg-amber-500 text-white text-sm font-semibold py-2.5 rounded-xl text-center group-hover:bg-amber-600 transition-colors">
                Ver en Amazon →
              </div>
              <div class="text-xs text-center text-gray-400 mt-2">Enlace de afiliado</div>
            </a>
          )}

          {restProducts.length > 0 && (
            <div class="rounded-2xl border border-gray-100 overflow-hidden">
              <div class="px-4 py-3 bg-gray-50 border-b border-gray-100">
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Más opciones</p>
              </div>
              {restProducts.map((product, i) => (
                <a href={product.link} target="_blank" rel="noopener noreferrer nofollow"
                   class="flex items-start gap-3 p-4 border-b border-gray-50 last:border-0 hover:bg-gray-50 transition-colors group">
                  <div class="w-6 h-6 rounded-full bg-gray-100 flex items-center justify-center text-xs font-bold text-gray-500 shrink-0 group-hover:bg-amber-100 group-hover:text-amber-700 transition-colors">
                    {i + 2}
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="text-sm font-medium text-gray-900 leading-snug group-hover:text-amber-700 transition-colors">{product.name}</div>
                    {product.price && <div class="text-xs font-semibold text-gray-700 mt-0.5">{product.price}</div>}
                    <div class="text-xs text-amber-600 mt-0.5">Ver en Amazon →</div>
                  </div>
                </a>
              ))}
            </div>
          )}

          <!-- Author card -->
          <div class="rounded-2xl border border-gray-100 p-4">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-9 h-9 rounded-xl bg-gray-900 flex items-center justify-center shrink-0">
                <svg viewBox="0 0 36 36" class="w-full h-full">
                  <text x="18" y="22" font-family="Georgia,serif" font-size="11" font-weight="700" fill="#FF3A3A" text-anchor="middle">CM</text>
                </svg>
              </div>
              <div>
                <div class="text-sm font-semibold text-gray-900">Dr. Cristian Miranda</div>
                <div class="text-xs text-gray-400">Médico · MIR España 2026</div>
              </div>
            </div>
            <p class="text-xs text-gray-500 leading-relaxed">Todo el contenido tiene referencia científica. Si algo no te cuadra, pregúntame.</p>
            <a href="https://x.com/cristianmirandamd" target="_blank"
               class="mt-3 flex items-center justify-center gap-1.5 text-xs text-gray-500 border border-gray-200 rounded-lg py-2 hover:border-gray-400 hover:text-gray-900 transition-colors">
              <svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.748l7.73-8.835L1.254 2.25H8.08l4.259 5.631z"/></svg>
              Seguir en X
            </a>
          </div>
        </div>
      </aside>

    </div>
  </div>
</Layout>
