---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function formatDate(date: Date) {
  return date.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
}

const categories = [...new Set(posts.map(p => p.data.category))];
---

<Layout title="Blog para pacientes" description="Salud basada en evidencia explicada en lenguaje claro. Sin bulos, sin sensacionalismo.">
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-12 pb-4">
    <h1 class="font-lora text-3xl sm:text-4xl font-semibold text-gray-900 mb-3">Para pacientes</h1>
    <p class="text-gray-500 max-w-xl">Evidencia científica en lenguaje que todos pueden entender. Suplementos, dispositivos, enfermedades, prevención.</p>
  </section>

  {categories.length > 1 && (
    <section class="max-w-6xl mx-auto px-4 sm:px-6 py-4">
      <div class="flex flex-wrap gap-2">
        {categories.map(cat => (
          <span class="border border-gray-200 text-gray-600 text-xs px-3 py-1.5 rounded-full hover:border-red-300 hover:text-red-500 cursor-pointer transition-colors">
            {cat}
          </span>
        ))}
      </div>
    </section>
  )}

  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
    {posts.length === 0 ? (
      <p class="text-gray-400 text-center py-20">Próximamente — el primer artículo llega mañana.</p>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post) => (
          <a href={`/blog/${post.id}`} class="group border border-gray-100 rounded-2xl p-5 hover:border-red-200 hover:shadow-sm transition-all">
            <span class="text-xs text-red-500 font-medium uppercase tracking-wide">{post.data.category}</span>
            <h2 class="font-semibold text-gray-900 mt-2 mb-2 group-hover:text-red-500 transition-colors leading-snug">{post.data.title}</h2>
            <p class="text-sm text-gray-500 line-clamp-3">{post.data.description}</p>
            {post.data.affiliateProducts && post.data.affiliateProducts.length > 0 && (
              <span class="inline-block mt-3 text-xs bg-amber-50 text-amber-700 px-2 py-0.5 rounded">
                Incluye recomendaciones
              </span>
            )}
            <p class="text-xs text-gray-400 mt-3">{formatDate(post.data.pubDate)}</p>
          </a>
        ))}
      </div>
    )}
  </section>
</Layout>
