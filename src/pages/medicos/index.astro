---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('medicos'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function formatDate(date: Date) {
  return date.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
}

const evidenceBadge: Record<string, string> = {
  A: 'bg-green-50 text-green-700',
  B: 'bg-blue-50 text-blue-700',
  C: 'bg-yellow-50 text-yellow-700',
  experto: 'bg-gray-50 text-gray-600',
};
---

<Layout title="Para médicos" description="Guías clínicas, estudios y práctica basada en evidencia. ESC, ACC, ADA, GOLD, KDIGO y más.">
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-12 pb-4">
    <h1 class="font-lora text-3xl sm:text-4xl font-semibold text-gray-900 mb-3">Para médicos</h1>
    <p class="text-gray-500 max-w-xl">Análisis de guías clínicas actualizadas, papers que cambian la práctica, perlas MIR y casos clínicos con razonamiento.</p>
  </section>

  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
    {posts.length === 0 ? (
      <p class="text-gray-400 text-center py-20">Próximamente — artículos técnicos para médicos.</p>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post) => (
          <a href={`/medicos/${post.id}`} class="group border border-gray-100 rounded-2xl p-5 hover:border-blue-200 hover:shadow-sm transition-all">
            <div class="flex items-center gap-2 mb-2">
              <span class="text-xs text-blue-500 font-medium uppercase tracking-wide">{post.data.specialty}</span>
              {post.data.evidenceLevel && (
                <span class={`text-xs px-1.5 py-0.5 rounded font-medium ${evidenceBadge[post.data.evidenceLevel] ?? 'bg-gray-50 text-gray-600'}`}>
                  Evidencia {post.data.evidenceLevel}
                </span>
              )}
            </div>
            <h2 class="font-semibold text-gray-900 mt-1 mb-2 group-hover:text-blue-500 transition-colors leading-snug">{post.data.title}</h2>
            <p class="text-sm text-gray-500 line-clamp-2">{post.data.description}</p>
            {post.data.guidelines && post.data.guidelines.length > 0 && (
              <div class="flex flex-wrap gap-1 mt-3">
                {post.data.guidelines.slice(0, 2).map(g => (
                  <span class="text-xs border border-blue-100 text-blue-500 px-2 py-0.5 rounded">{g}</span>
                ))}
              </div>
            )}
            <p class="text-xs text-gray-400 mt-3">{formatDate(post.data.pubDate)}</p>
          </a>
        ))}
      </div>
    )}
  </section>
</Layout>
